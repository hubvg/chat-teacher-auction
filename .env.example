# Copy this file to .env.local to try bidding with `npm run dev`.
# On Vercel, add the same two variables under Project Settings > Environment Variables.

# The Apps Script web app URL from README step 3 (ends in /exec).
BIDS_SOURCE_URL=

# The secret that running setup in the Apps Script shows (README step 3).
# Keep it private: anyone who has it could post bids straight to the sheet.
BIDS_SECRET=

# Optional. Only needed if you host somewhere other than Vercel or want to force a domain.
# SITE_URL=https://auction.yourschool.ca
