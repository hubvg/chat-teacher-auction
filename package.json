{
  "name": "teacher-auction",
  "version": "1.0.0",
  "private": true,
  "description": "Live board for a school teacher auction. People bid on the site; bids are saved to a Google Sheet by a small Apps Script.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "tsx --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "satori": "^0.63.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
